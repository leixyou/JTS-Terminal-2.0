<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(INFOPLIST_KEY_CFBundleDisplayName)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(INFOPLIST_KEY_CFBundleName)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>JTSBuildSourceCommit</key>
	<string>$(JTS_BUILD_SOURCE_COMMIT)</string>
	<key>JTSBuildSourceSHA256</key>
	<string>$(JTS_BUILD_SOURCE_SHA256)</string>
	<key>LSApplicationCategoryType</key>
	<string>$(INFOPLIST_KEY_LSApplicationCategoryType)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(INFOPLIST_KEY_NSHumanReadableCopyright)</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>$(INFOPLIST_KEY_NSLocalNetworkUsageDescription)</string>
	<!-- User-supplied relay hosts use the dedicated HTTPS trust delegate.
	     Enrollment requires HTTPS and authenticates its encrypted exchange. -->
	<key>NSAppTransportSecurity</key>
	<dict><key>NSAllowsArbitraryLoads</key><true/></dict>
</dict>
</plist>
